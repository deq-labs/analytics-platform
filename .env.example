# Copy to .env (gitignored) and adjust. Local development values only.
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=analytics
CLICKHOUSE_PASSWORD=change_me

POSTGRES_DB=analytics_app
POSTGRES_USER=analytics
POSTGRES_PASSWORD=change_me

# Optional: IP geolocation. Free account + licence key at https://www.maxmind.com
# (GeoLite2). Used only by the geoipupdate container in docker-compose.yml.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# Self-hosting with `docker compose --profile app up -d --build` (optional).
# APP_PORT: host port for the dashboard + API (default 8080).
# OPEN_REGISTRATION: true = anyone can sign up (SaaS); false = invite-only.
# BEHIND_PROXY: true only when a TLS reverse proxy is the sole way in.
APP_PORT=8080
OPEN_REGISTRATION=false
BEHIND_PROXY=false
