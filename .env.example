# Copy to .env (gitignored) and adjust. Local development values only.
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=analytics
CLICKHOUSE_PASSWORD=change_me

POSTGRES_DB=analytics_app
POSTGRES_USER=analytics
POSTGRES_PASSWORD=change_me

# Optional: IP geolocation. Free account + licence key at https://www.maxmind.com
# (GeoLite2). Used only by the geoipupdate container in docker-compose.yml.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
