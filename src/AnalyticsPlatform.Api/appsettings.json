{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ingestion": {
    "QueueCapacity": 100000,
    "MaxBatchSize": 5000,
    "FlushInterval": "00:00:01",
    "InitialRetryDelay": "00:00:00.500",
    "MaxRetryDelay": "00:00:30"
  }
}
