# Run the API (F5), then click "Send request" above any request below.
# Site 1 = cookie-less hash mode, site 2 = persistent mode (see scripts/dev_seed.sql).
#
# Tracking IDs are random per database. These are one developer's values --
# replace them with yours (the last lines scripts/dev_seed.sql prints).
# Event URLs must be on the site's domain (localhost / persistent.localhost).

@api = http://localhost:5115
@site1 = ap_0f821f0c93644515
@site2 = ap_d223a7983fbe4f0d

### Health check
GET {{api}}/health

### Pageview (site 1, hash mode)
POST {{api}}/api/events
Content-Type: application/json

{
  "trackingId": "{{site1}}",
  "type": "pageview",
  "url": "https://localhost/pricing",
  "referrer": "https://google.com/",
  "screenWidth": 1920,
  "screenHeight": 1080
}

### Standard event: scroll depth
POST {{api}}/api/events
Content-Type: application/json

{
  "trackingId": "{{site1}}",
  "type": "standard",
  "name": "scroll",
  "url": "https://localhost/pricing",
  "properties": { "depth": "90" }
}

### Custom event
POST {{api}}/api/events
Content-Type: application/json

{
  "trackingId": "{{site1}}",
  "type": "custom",
  "name": "signup_click",
  "url": "https://localhost/pricing",
  "properties": { "plan": "pro" }
}

### Pageview (site 2, persistent mode, browser-provided ID)
POST {{api}}/api/events
Content-Type: application/json

{
  "trackingId": "{{site2}}",
  "type": "pageview",
  "url": "https://persistent.localhost/",
  "visitorId": "7c1e2f40-8a5b-4c3d-9e1f-0a2b3c4d5e6f"
}

### Should fail (400): custom event using a reserved standard name
POST {{api}}/api/events
Content-Type: application/json

{
  "trackingId": "{{site1}}",
  "type": "custom",
  "name": "scroll",
  "url": "https://localhost/"
}

###############################################################################
# Since Phase 7 the stats requests below need a signed-in session, so they
# return 401 from here. Use the dashboard (sign in there), or the per-site API
# keys coming in Phase 7 step 4 for scripted access.
###############################################################################
# Stats (Phase 3). Site 5 = "Demo data" -- check your id with the last lines of
# scripts/dev_seed.sql, and fill it with scripts/dev_events.sql.
# Dates are UTC. Omit from/to for the last 7 days.
###############################################################################
@demoSite = 5

### Pageviews per day
GET {{api}}/api/sites/{{demoSite}}/stats/pageviews?interval=day

### Pageviews per hour (ranges up to 31 days)
GET {{api}}/api/sites/{{demoSite}}/stats/pageviews?interval=hour&from=2026-11-06&to=2026-11-07

### Top pages
GET {{api}}/api/sites/{{demoSite}}/stats/top-pages?limit=10

### Top referrers (counted per session; "domain": null = direct)
GET {{api}}/api/sites/{{demoSite}}/stats/top-referrers?limit=10

### Should fail (400): page on a domain that isn't the site's
POST {{api}}/api/events
Content-Type: application/json

{
  "trackingId": "{{site1}}",
  "type": "pageview",
  "url": "https://someone-elses-site.example/"
}
