<Project Sdk="Microsoft.NET.Sdk">

  <!-- End-to-end tests: the real API against throwaway ClickHouse + Postgres
       containers. Requires Docker. Never touches your dev databases. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <!-- WebApplicationFactory: runs the API in-memory, no ports, no Kestrel. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <!-- Testcontainers: starts real database containers for the test run. -->
    <PackageReference Include="Testcontainers.ClickHouse" Version="4.16.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AnalyticsPlatform.Api\AnalyticsPlatform.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Bake the repo root into the test assembly, so the fixture can find the
       SQL init scripts no matter where the build output goes. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RepoRoot</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../..'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
